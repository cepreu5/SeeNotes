{
    "name": "CX-Notes",
    "short_name": "CX-Notes",
    "description": "CX-Notes - Вашите бележки, винаги с вас.",
    "id": "./?source=pwa",
    "start_url": "./index.html?source=pwa",
    "scope": "./",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#000000",
    "theme_color": "#000000",
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "share_target": {
        "action": "/index.html",
        "method": "GET",
        "params": {
            "title": "shared_title",
            "text": "shared_text",
            "url": "shared_url",
            "files": [
                {
                    "name": "shared_image",
                    "accept": [
                        "image/*"
                    ]
                }
            ]
        }
    },
    "icons": [
        {
            "src": "CXNotes48.png",
            "sizes": "48x48",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "CXNotes72.png",
            "sizes": "72x72",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "CXNotes96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "CXNotes144.png",
            "sizes": "144x144",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "CXNotes180.png",
            "sizes": "180x180",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "CXNotes192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "CXNotes384.png",
            "sizes": "384x384",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "CXNotes512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ]
}